{
  "$comment": [
    "Shared input of the cross-language golden test. Every language builds the same",
    "file with its own MdfWriter (see `build_scenario_file` in tests/api_contract.rs,",
    "tests/test_api_contract.py and js/test/contract.test.ts), answers the calls listed",
    "here with both Mdf and MdfIndex, and must reproduce tests/contract/golden.json.",
    "Regenerate the golden file with: UPDATE_GOLDEN=1 cargo test --test api_contract"
  ],
  "read_cases": [
    { "name": "Speed" },
    { "name": "Speed", "group": "Engine", "start_time": 1.0, "end_time": 2.0 },
    { "name": "Speed", "end_time": 0.75 },
    { "name": "Speed", "start_time": 2.0, "end_time": 1.0 },
    { "name": "Speed", "start_record": 4, "record_count": 2 },
    { "name": "Speed", "start_record": 4, "record_count": 5 },
    { "name": "Speed", "start_record": 6 },
    { "name": "Speed", "start_time": 0.0, "start_record": 0 },
    { "name": "Time" },
    { "name": "Time", "start_time": 0.5, "end_time": 1.0 },
    { "name": "Gear" },
    { "name": "Raw" },
    { "name": "Small" },
    { "name": "Label", "start_record": 1, "record_count": 2 },
    { "name": "Latin" },
    { "name": "Wide" },
    { "name": "Blob" },
    { "name": "Count" },
    { "name": "Count", "group": "NoMaster", "start_record": 1, "record_count": 1 },
    { "name": "Count", "start_time": 0.0 },
    { "name": "Value" },
    { "name": "Value", "group": "Empty", "start_time": 0.0 },
    { "name": "Speed", "group": "Empty" },
    { "name": "Nope" },
    { "name": "Nope", "start_time": 0.0, "start_record": 0 }
  ],
  "channel_cases": [
    { "name": "Speed" },
    { "name": "Gear", "group": "Engine" },
    { "name": "Time" },
    { "name": "Label" },
    { "name": "Blob" },
    { "name": "Count" },
    { "name": "Value", "group": "Empty" },
    { "name": "Speed", "group": "NoMaster" },
    { "name": "Nope" }
  ],
  "write_cases": {
    "$comment": "Python and TypeScript: write_record of one plain value into a one-channel group. int values are strings so 64-bit values survive JSON; TypeScript passes them as a number when safe, else a bigint.",
    "channels": {
      "u64": "add_int_channel",
      "i64": "add_sint_channel",
      "f64": "add_float_channel",
      "f32": "add_float32_channel",
      "text": "add_string_channel",
      "u32": "UnsignedIntegerLE",
      "i32": "SignedIntegerLE",
      "bytes": "ByteArray"
    },
    "cases": [
      { "channel": "u64", "value": { "int": "5" }, "ok": true },
      { "channel": "u64", "value": { "int": "18446744073709551615" }, "ok": true },
      { "channel": "u64", "value": { "int": "-5" }, "ok": false },
      { "channel": "u64", "value": { "float": 3.0 }, "ok": true },
      { "channel": "u64", "value": { "float": 1.5 }, "ok": false },
      { "channel": "u64", "value": { "float": "nan" }, "ok": false },
      { "channel": "u64", "value": { "bool": true }, "ok": false },
      { "channel": "u64", "value": { "text": "5" }, "ok": false },
      { "channel": "i64", "value": { "int": "-9223372036854775808" }, "ok": true },
      { "channel": "i64", "value": { "int": "9223372036854775808" }, "ok": false },
      { "channel": "i64", "value": { "float": -2.0 }, "ok": true },
      { "channel": "i64", "value": { "float": 0.5 }, "ok": false },
      { "channel": "f64", "value": { "int": "7" }, "ok": true },
      { "channel": "f64", "value": { "float": 1.5 }, "ok": true },
      { "channel": "f64", "value": { "float": "nan" }, "ok": true },
      { "channel": "f64", "value": { "bool": false }, "ok": false },
      { "channel": "f64", "value": { "text": "1.5" }, "ok": false },
      { "channel": "f32", "value": { "float": 1.5 }, "ok": true },
      { "channel": "text", "value": { "text": "hello" }, "ok": true },
      { "channel": "text", "value": { "int": "5" }, "ok": false },
      { "channel": "text", "value": { "bytes": [104, 105] }, "ok": false },
      { "channel": "u32", "value": { "int": "4294967295" }, "ok": true },
      { "channel": "u32", "value": { "int": "4294967296" }, "ok": false },
      { "channel": "i32", "value": { "int": "-2147483648" }, "ok": true },
      { "channel": "i32", "value": { "int": "2147483648" }, "ok": false },
      { "channel": "bytes", "value": { "bytes": [1, 2, 3] }, "ok": true },
      { "channel": "bytes", "value": { "text": "abc" }, "ok": false }
    ]
  }
}
